# =============================================================================
# .gitignore — Patrones no versionados (root del repo)
# =============================================================================
# El arnés mismo usa .jcode/.jcodeignore para sus internos.
# Aquí van artefactos globales del repo, no de .jcode/.
# =============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Virtual environments
venv/
.venv/
env/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS files
*.log
*.bak
*.tmp

# Local environment / secrets
.env
.env.local
*.pem
*.key
*.secret

# Analysis / debugging artifacts
*.pdf
*.zip
proyecto-*.zip

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.tox/
.mypy_cache/
.ruff_cache/

# Documentation builds
docs/_build/
site/

# Project-specific outputs (no commitear)
src/*.pyc
bin/*.pyc
